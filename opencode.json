{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "nx *": "allow",
      "npx nx *": "allow",
      "pnpm nx *": "allow",
      "pnpm add*": "allow",
      "pnpm install*": "allow",
      "dotnet build*": "allow",
      "dotnet list*": "allow",
      "dotnet test*": "allow",
      "git commit*": "deny",
      "git push*": "deny"
    }
  }
}
