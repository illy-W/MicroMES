{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@micromes/api-client/models": ["./libs/shared/api-client/src/generated/model/index.ts"],
      "@micromes/api-client/services/*": ["./libs/shared/api-client/src/generated/services/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
