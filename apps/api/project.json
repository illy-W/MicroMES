{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": [],
  "targets": {
    "build:dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "dotnet build -c Development -p:OpenApiGenerateDocuments=false"
      }
    },
    "build:dev:doc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "dotnet build -c Development -p:OpenApiGenerateDocuments=true"
      }
    },
    "build:release": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/bin/Release", "{projectRoot}/obj/Release"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "dotnet build -c Release -p:OpenApiGenerateDocuments=false"
      }
    },
    "build:release:doc": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/bin/Release", "{projectRoot}/obj/Release"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "dotnet build -c Release -p:OpenApiGenerateDocuments=true"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "dotnet watch run"
      },
      "dependsOn": ["build:dev"]
    },
    "db-up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose up -d --wait db"
      }
    },
    "db-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose down"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "rm -rf dist/apps/api && dotnet publish apps/api -c Release -o dist/apps/api -p:OpenApiGenerateDocuments=false -p:InformationalVersion=\"${VERSION:-0.0.0-dev}\""
      }
    },
    "docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["publish"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker build -f apps/api/Dockerfile -t micromes-api:local --build-arg VERSION=\"${VERSION:-0.0.0-dev}\" --build-arg COMMIT=\"${COMMIT:-$(git rev-parse --short HEAD 2>/dev/null || echo unknown)}\" --build-arg BUILD_DATE=\"${BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}\" ."
      }
    }
  }
}
